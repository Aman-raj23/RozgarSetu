# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rozgarsetu

# JWT secret key (change this to a strong random string)
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=5000

# Email sender address (used as "from" in OTP emails)
EMAIL_USER=your_email@gmail.com

# Brevo (formerly Sendinblue) API key for sending emails via HTTP
# Sign up at https://www.brevo.com → SMTP & API → API Keys → Generate
BREVO_API_KEY=your_brevo_api_key_here

# Frontend Deployed URL (for CORS)
FRONTEND_URL=https://your-frontend-url.onrender.com
